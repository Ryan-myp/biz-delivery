{
  "business_domain": "creative-platform",
  "repositories": [
    {
      "name": "creative-platform",
      "path": "/Users/yanping.ma/GolandProjects/creative-platform",
      "language": "go",
      "max_files": 500
    }
  ],
  "learn_config": {
    "max_files_per_lang": 500
  },
  "modules": [
    {
      "name": "Creative Platform / 创意平台",
      "keywords": [
        "creative",
        "template",
        "render",
        "media",
        "adgroup",
        "ad_group",
        "creative_platform"
      ],
      "goal": "维护创意素材、广告组、模板渲染等创意平台核心能力。"
    },
    {
      "name": "Share / 分享",
      "keywords": [
        "share",
        "partner",
        "resend",
        "add_on",
        "creative_requirement"
      ],
      "goal": "素材分享给合作伙伴、创意需求管理。"
    },
    {
      "name": "PNS / 合作伙伴网络服务",
      "keywords": [
        "requirement",
        "partner",
        "pns",
        "creative_requirement"
      ],
      "goal": "合作伙伴创意需求管理。"
    },
    {
      "name": "Auth / 权限",
      "keywords": [
        "auth",
        "permission",
        "role",
        "middleware"
      ],
      "goal": "平台权限控制。"
    },
    {
      "name": "Config / 配置",
      "keywords": [
        "config",
        "apollo",
        "gas"
      ],
      "goal": "平台配置管理。"
    }
  ],
  "query_aliases": {
    "素材分享": [
      "share",
      "share_new",
      "share_addon",
      "share_resend"
    ],
    "广告组创建": [
      "create_adgroup",
      "edit_adgroup",
      "get_adgroup_detail",
      "delete_adgroup"
    ],
    "PN 处理": [
      "requirement",
      "save_requirement",
      "delete_requirement",
      "get_adgroup_requirement"
    ],
    "合作伙伴": [
      "partner",
      "list_partners",
      "save_partner"
    ],
    "鉴权": [
      "auth",
      "permission",
      "middleware"
    ],
    "配置": [
      "config",
      "apollo",
      "gas"
    ]
  },
  "state_machines": {
    "Task.Status": {
      "fields": [
        "SUCC",
        "AD_SHARE_RECORD_FAIL",
        "GSHEET_FAIL",
        "MAIL_FAIL",
        "MAIL_NOTIFICATION_RECORD_FAIL"
      ],
      "values": {
        "0": "TASK_STATUS_SUCC",
        "1": "TASK_STATUS_AD_SHARE_RECORD_FAIL",
        "2": "TASK_STATUS_GSHEET_FAIL",
        "3": "TASK_STATUS_MAIL_FAIL",
        "4": "TASK_STATUS_MAIL_NOTIFICATION_RECORD_FAIL"
      }
    },
    "AdGroup.Status": {
      "fields": [
        "INIT",
        "SUBMITTED",
        "SHARED",
        "LIVE",
        "PAUSED"
      ],
      "values": {
        "0": "AD_GROUP_STATUS_INIT",
        "1": "AD_GROUP_STATUS_SUBMITTED",
        "2": "AD_GROUP_STATUS_SHARED",
        "3": "AD_GROUP_STATUS_LIVE",
        "4": "AD_GROUP_STATUS_PAUSED"
      }
    },
    "AdGroup.OpStatus": {
      "fields": [
        "INIT",
        "SUBMITTED",
        "PENDING_SHARE",
        "SHARED",
        "ADD_ON",
        "PENDING_REGULAR_PAUSED",
        "PENDING_EMERGENCY_PAUSED"
      ],
      "values": {
        "0": "AD_GROUP_OP_STATUS_INIT",
        "1": "AD_GROUP_OP_STATUS_SUBMITTED",
        "101": "AD_GROUP_OP_STATUS_PENDING_SHARE",
        "2": "AD_GROUP_OP_STATUS_SHARED",
        "201": "AD_GROUP_OP_STATUS_ADD_ON",
        "202": "AD_GROUP_OP_STATUS_PENDING_REGULAR_PAUSED",
        "203": "AD_GROUP_OP_STATUS_PENDING_EMERGENCY_PAUSED"
      }
    }
  },
  "business_rules": {
    "general_errors": [
      "SUCCESS: success",
      "UNKOWN_ERROR: unknown error",
      "INVALID_PARAMS: invalid params",
      "NETWORK_ERROR: network error",
      "SERVER_BUSY: server busy"
    ],
    "database_errors": [
      "DB_NOT_FOUND: not found from database",
      "DB_DATA_DUPLICATE: insert data exists",
      "DB_QUERY_FAIL: database query failed",
      "DB_EXCUTE_FAIL: database execute failed",
      "DB_TRANSACTION_FAIL: database transaction failed"
    ],
    "redis_errors": [
      "RDS_INCR_FAIL: redis incr failed",
      "RDS_LOCK_IS_LOCKING: redis lock is locking by others",
      "RDS_SET_FAIL: redis set failed",
      "RDS_GET_FAIL: redis get failed",
      "RDS_DEL_FAIL: redis del failed"
    ],
    "http_errors": [
      "HTTP_REQUEST_FAIL: http request failed",
      "HTTP_READ_BODY_FAIL: http read body failed",
      "HTTP_REQUEST_NO_BODY: http request no body",
      "HTTP_NEW_REQUEST_FAIL: http new request fail",
      "HTTP_INVALID_STATUS: http invalid status"
    ],
    "creative_errors": [
      "USER_NOT_LOGIN: user not login",
      "USER_NOT_FOUND: user not found"
    ],
    "imagestop_errors": [
      "USER_NOT_PERMISSION: user no permission",
      "WRONG_URL_PATH_TO_PREMISSION: wrong url path to error",
      "PERMISSION_INVALID: user permission invalid"
    ],
    "other_errors": [
      "JSON_FORMAT_ERROR: request json format error",
      "S3_CLIENT_INVALID: s3 client invalid",
      "S3_UPLOAD_FAIL: s3 upload failed",
      "S3_DOWNLOAD_FAIL: s3 download failed",
      "S3_DELETE_FAIL: s3 delete failed"
    ],
    "adshare_errors": [
      "BUSINESS_CONFIG_NOT_FOUND: business config not found",
      "BUSINESS_CONFIG_MODULE_DUPLICATE: business config module duplicate",
      "BUSINESS_CONFIG_MODULE_NOT_DEFINE: business config module not defined",
      "BUSINESS_CONFIG_MUDULE_ITEM_DUPLICATE: business config module item duplicate",
      "BUSINESS_CONFIG_MUDULE_ITEM_NOT_FOUND: business config module item not found"
    ],
    "adgroup_constraints": [
      "MAX_AD_GROUP_CAMPAIGN_NAME_SIZE = 50",
      "MAX_AD_GROUP_LAST_EDIT_BY_SIZE = 50",
      "MAX_AD_GROUP_SHORTEN_HEADLINE_SIZE = 19",
