      "MAX_AD_GROUP_SHORTEN_TEXT_SIZE = 42",
      "MAX_AD_GROUP_TEXT_SIZE = 90",
      "MAX_AD_GROUP_CUSTOM_LANDING_PAGE = 700",
      "MAX_AD_GROUP_CUSTOM_LANDING_PAGE_DEEP_LINK = 700",
      "MAX_AD_GROUP_AUTO_MAIL_ID_SIZE = 20",
      "MAX_AD_GROUP_BATCH_DOWNLOAD_SIZE = 5"
    ],
    "media_constraints": [
