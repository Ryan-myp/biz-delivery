  },
  "service_topology": {
    "services": [
      {
        "name": "DAP (Creative Platform)",
        "description": "创意平台主服务",
        "port": 8888,
        "dependencies": [
          "MySQL",
          "Redis",
          "Apollo Config"
        ]
      },
      {
        "name": "MySQL",
        "description": "关系型数据库",
        "entities": [
          "AdGroup",
          "Creative",
          "Template",
          "Partner",
          "Requirement"
        ]
      },
      {
        "name": "Redis",
        "description": "缓存/分布式锁",
        "usage": [
          "session_cache",
          "distributed_lock",
          "permission_check"
        ]
      },
      {
        "name": "Apollo Config",
        "description": "配置中心",
        "instances": [
          "apollo-config.i.toc-mkt.shopee.io"
        ]
      },
      {
        "name": "ADP (Ad Delivery Platform)",
        "description": "广告投放平台",
        "rpc_calls": [
          "BuildCloseMainTicketRequestFromCloseCreativeRequest",
          "BuildCreativeRequestUpdateNotifyRequest"
        ]
      },
      {
        "name": "Proxy",
        "description": "代理层，转发到渠道 API"
      },
      {
        "name": "MetaAPI",
        "description": "Meta 渠道 API"
      },
      {
        "name": "TikTokAPI",
        "description": "TikTok 渠道 API"
      },
      {
        "name": "DV360API",
        "description": "DV360 渠道 API"
      }
    ]
  }
}