{
  "business_domain": "creative-platform",
  "repositories": [
    {
      "name": "creative-platform",
      "path": "/Users/yanping.ma/GolandProjects/creative-platform",
      "language": "go",
      "max_files": 500
    }
  ],
  "learn_config": {
    "max_files_per_lang": 500
  },
  "modules": [
    {
      "name": "Creative Platform / 创意平台",
      "keywords": [
        "creative",
        "template",
        "render",
        "media",
        "adgroup",
        "ad_group",
        "creative_platform"
      ],
      "goal": "维护创意素材、广告组、模板渲染等创意平台核心能力。"
    },
    {
      "name": "Share / 分享",
      "keywords": [
        "share",
        "partner",
        "resend",
        "add_on",
        "creative_requirement"
      ],
      "goal": "素材分享给合作伙伴、创意需求管理。"
    },
    {
      "name": "PNS / 合作伙伴网络服务",
      "keywords": [
        "requirement",
        "partner",
        "pns",
        "creative_requirement"
      ],
      "goal": "合作伙伴创意需求管理。"
    },
    {
      "name": "Auth / 权限",
      "keywords": [
        "auth",
        "permission",
        "role",
        "middleware"
      ],
      "goal": "平台权限控制。"
    },
    {
      "name": "Config / 配置",
      "keywords": [
        "config",
        "apollo",
        "gas"
      ],
      "goal": "平台配置管理。"
    }
  ],
  "query_aliases": {
    "素材分享": [
      "share",
      "share_new",
      "share_addon",
      "share_resend"
    ],
    "广告组创建": [
      "create_adgroup",
      "edit_adgroup",
      "get_adgroup_detail",
      "delete_adgroup"
    ],
    "PN 处理": [
      "requirement",
      "save_requirement",
      "delete_requirement",
      "get_adgroup_requirement"
    ],
    "合作伙伴": [
      "partner",
      "list_partners",
      "save_partner"
    ],
    "鉴权": [
      "auth",
      "permission",
      "middleware"
    ],
    "配置": [
      "config",
      "apollo",
      "gas"
    ]
  },
  "state_machines": {
    "AdGroup": {
      "fields": [
        "Status",
        "OpStatus"
      ],
      "Status": {
        "values": {
          "0": "INIT",
          "1": "SUBMITTED",
          "2": "SHARED",
          "3": "LIVE",
          "4": "PAUSED"
        }
      },
      "OpStatus": {
        "values": {
          "0": "INIT",
          "1": "SUBMITTED",
          "2": "SHARED",
          "101": "PENDING_SHARE",
          "201": "ADD_ON",
          "202": "PENDING_REGULAR_PAUSED",
          "203": "PENDING_EMERGENCY_PAUSED"
        }
      }
    },
    "Task": {
      "fields": [
        "Status"
      ],
      "Status": {
        "values": {
          "0": "SUCC",
          "1": "AD_SHARE_RECORD_FAIL",
          "2": "GSHEET_FAIL",
          "3": "MAIL_FAIL",
          "4": "MAIL_NOTIFICATION_RECORD_FAIL"
        }
      }
    },
    "ImageStopTemplate": {
      "fields": [
        "TemplateStatus",
        "IsDeleted",
        "IsDraft"
      ],
      "TemplateStatus": {
        "values": {
          "0": "DRAFT",
          "1": "PENDING_APPROVAL",
          "2": "REJECTED",
          "3": "READY_TO_USE"
        }
      }
    }
  },
  "business_rules": {
    "adgroup_creation": [
      "AdGroup Name 不能为空",
      "AdGroup Name 长度不能超过 255 字符",
      "AdGroup Status 只能是 INIT/SUBMITTED/SHARED/LIVE/PAUSED"
    ],
    "adgroup_share": [
      "只有 AdGroup Owner 才能发起分享",
      "Partner 必须存在且状态正常",
      "AdGroup 不能重复分享给同一个 Partner"
    ],
    "image_stop_template": [
      "Template 必须经过审核才能上线",
      "审核状态只能是 DRAFT/PENDING_APPROVAL/REJECTED/READY_TO_USE",
      "拒绝时需要记录拒绝原因"
    ]
  },
  "service_topology": {
    "services": [
      {
        "name": "DAP",
        "port": 8888,
        "dependencies": [
          "Apollo Config",
          "MySQL",
          "Redis",
          "ADP",
          "Proxy"
        ]
      },
      {
        "name": "Apollo Config",
        "instances": [
          "apollo-config.i.toc-mkt.shopee.io"
        ]
      },
      {
        "name": "ADP",
        "rpc_calls": [
          "BuildCloseMainTicketRequestFromCloseCreativeRequest",
          "BuildCreativeRequestUpdateNotifyRequest"
        ]
      },
      {
        "name": "Proxy",
        "description": "代理层，转发到渠道 API"
      },
      {
        "name": "MetaAPI",
        "description": "Meta 渠道 API"
      },
      {
        "name": "TikTokAPI",
        "description": "TikTok 渠道 API"
      },
      {
        "name": "DV360API",
        "description": "DV360 渠道 API"
      }
    ]
  }
}