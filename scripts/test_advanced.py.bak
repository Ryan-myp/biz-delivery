class TestEdgeCases(unittest.TestCase):
    """边界情况测试"""
    
    def test_empty_prd(self):
        """测试空 PRD"""
        from review_engine import ReviewEngine
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        result = engine.review("")
        self.assertEqual(result["status"], "prompt_ready")
    
    def test_very_long_prd(self):
        """测试超长 PRD"""
        from review_engine import ReviewEngine
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        prd = "# 需求\n" + "这是第{}行\n".format(i) * 1000
        result = engine.review(prd)
        self.assertEqual(result["status"], "prompt_ready")
    
    def test_special_characters(self):
        """测试特殊字符"""
        from review_engine import ReviewEngine
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        prd = "# 需求\n特殊字符: < > & \" ' ` $ ! @ # % ^ & * ( )\n中文：测试\nEmoji: 😀 😂 🎉"
        result = engine.review(prd)
        self.assertEqual(result["status"], "prompt_ready")
    
    def test_multilingual_prd(self):
        """测试多语言 PRD"""
        from review_engine import ReviewEngine
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        prd = """
        # 需求 (中文)
        
        ## Features (English)
        - User bidding
        - Budget control
        
        ### 功能 (Japanese)
        - 入札機能
        - 予算管理
        """
        result = engine.review(prd)
        self.assertEqual(result["status"], "prompt_ready")


class TestPerformance(unittest.TestCase):
    """性能测试"""
    
    def test_review_performance(self):
        """测试审查性能"""
        from review_engine import ReviewEngine
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        
        prd = "# 需求\n" + "这是第{}行内容\n".format(i) * 100
        
        start = time.time()
        result = engine.review(prd)
        elapsed = time.time() - start
        
        self.assertEqual(result["status"], "prompt_ready")
        self.assertLess(elapsed, 1.0, f"审查耗时过长: {elapsed}s")
    
    def test_td_performance(self):
        """测试 TD 生成性能"""
        from td_engine_v2 import TDEngine
        engine = TDEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        
        prd = "# 需求\n" + "这是第{}行内容\n".format(i) * 100
        
        start = time.time()
        result = engine.generate_td(prd, use_llm=False)
        elapsed = time.time() - start
        
        self.assertEqual(result["status"], "prompt_ready")
        self.assertLess(elapsed, 1.0, f"TD生成耗时过长: {elapsed}s")
    
    def test_concurrent_requests(self):
        """测试并发请求"""
        import threading
        from review_engine import ReviewEngine
        
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        results = []
        errors = []
        
        def review_prd(i):
            try:
                result = engine.review(f"# 需求{i}")
                results.append(result)
            except Exception as e:
                errors.append(e)
        
        # 并发 10 个请求
        threads = [threading.Thread(target=review_prd, args=(i,)) for i in range(10)]
        for t in threads:
            t.start()
        for t in threads:
            t.join()
        
        self.assertEqual(len(results), 10)
        self.assertEqual(len(errors), 0)


class TestErrorHandling(unittest.TestCase):
    """错误处理测试"""
    
    def test_invalid_profile(self):
        """测试无效 profile"""
        from review_engine import ReviewEngine
        with self.assertRaises((KeyError, TypeError)):
            engine = ReviewEngine(None, "/tmp")
    
    def test_missing_output_dir(self):
        """测试输出目录不存在"""
        from review_engine import ReviewEngine
        import tempfile
        import shutil
        
        base = tempfile.mkdtemp()
        try:
            output_dir = Path(base) / "nonexistent" / "dir"
            engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, output_dir)
            # 应该自动创建目录
            self.assertTrue(output_dir.exists())
        finally:
            shutil.rmtree(base)
    
    def test_large_prd_handling(self):
        """测试大 PRD 处理"""
        from review_engine import ReviewEngine
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        
        # 10000 行 PRD
        prd = "# 需求\n" + "这是第{}行内容\n".format(i) * 10000
        
        result = engine.review(prd)
        self.assertEqual(result["status"], "prompt_ready")


class TestDataConsistency(unittest.TestCase):
    """数据一致性测试"""
    
    def test_prompt_file_content(self):
        """测试 prompt 文件内容"""
        from review_engine import ReviewEngine
        engine = ReviewEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        
        prd = "# 用户出价系统\n\n## 功能需求\n1. 出价功能\n2. 预算管理"
        result = engine.review(prd)
        
        # 验证 prompt 文件
        prompt_file = Path(result["prompt_file"])
        self.assertTrue(prompt_file.exists())
        
        content = prompt_file.read_text(encoding="utf-8")
        self.assertIn("用户出价", content)
        self.assertIn("功能需求", content)
    
    def test_td_file_structure(self):
        """测试 TD 文件结构"""
        from td_engine_v2 import TDEngine
        engine = TDEngine({"name": "test", "repositories": [], "business_domain": "test"}, "/tmp")
        
        prd = "# 订单系统\n\n## 功能需求\n1. 创建订单\n2. 查询订单"
        result = engine.generate_td(prd, use_llm=False)
        
        prompt_file = Path(result["prompt_file"])
        content = prompt_file.read_text(encoding="utf-8")
        
        # 验证结构
        self.assertIn("订单", content)
        self.assertIn("技术方案", content)


def run_tests():
    """运行所有测试"""
    unittest.main(verbosity=2)


if __name__ == "__main__":
    run_tests()
