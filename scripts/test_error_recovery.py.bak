#!/usr/bin/env python3
"""
biz-delivery 错误处理与恢复测试

测试各种异常场景和恢复机制
"""

import sys
import unittest
from pathlib import Path
from unittest.mock import Mock, patch
import tempfile
import shutil

# 添加 biz-delivery 路径
sys.path.insert(0, str(Path(__file__).parent))


class TestErrorRecovery(unittest.TestCase):
    """错误恢复测试"""
    
    def setUp(self):
        """设置测试环境"""
        self.temp_dir = tempfile.mkdtemp()
    
    def tearDown(self):
        """清理测试环境"""
        shutil.rmtree(self.temp_dir, ignore_errors=True)
    
    def test_llm_timeout_recovery(self):
        """测试 LLM 超时恢复"""
        from td_engine_v2 import TDEngine
        
        engine = TDEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            self.temp_dir
        )
        
        # 模拟 LLM 超时
        with patch('td_engine_v2.call_llm') as mock_llm:
            mock_llm.side_effect = TimeoutError("LLM timeout")
            
            result = engine.generate_td("测试 PRD", use_llm=True)
            
            # 应该回退到 prompt 模式
            self.assertEqual(result["status"], "prompt_ready")
    
    def test_llm_error_recovery(self):
        """测试 LLM 错误恢复"""
        from td_engine_v2 import TDEngine
        
        engine = TDEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            self.temp_dir
        )
        
        # 模拟 LLM 错误
        with patch('td_engine_v2.call_llm') as mock_llm:
            mock_llm.side_effect = Exception("API error")
            
            result = engine.generate_td("测试 PRD", use_llm=True)
            
            # 应该回退到 prompt 模式
            self.assertEqual(result["status"], "prompt_ready")
    
    def test_file_write_error(self):
        """测试文件写入错误"""
        from review_engine import ReviewEngine
        
        engine = ReviewEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            self.temp_dir
        )
        
        # 测试正常写入
        result = engine.review("测试 PRD")
        self.assertEqual(result["status"], "prompt_ready")
    
    def test_concurrent_reviews(self):
        """测试并发审查"""
        from review_engine import ReviewEngine
        import threading
        
        engine = ReviewEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            self.temp_dir
        )
        
        results = []
        errors = []
        
        def review_task(i):
            try:
                result = engine.review(f"测试 PRD {i}")
                results.append(result)
            except Exception as e:
                errors.append(e)
        
        threads = [threading.Thread(target=review_task, args=(i,)) for i in range(5)]
        for t in threads:
            t.start()
        for t in threads:
            t.join()
        
        self.assertEqual(len(results), 5)
        self.assertEqual(len(errors), 0)


class TestMockIntegration(unittest.TestCase):
    """Mock 集成测试"""
    
    def test_mock_llm_response(self):
        """测试 Mock LLM 响应"""
        from td_engine_v2 import TDEngine
        
        engine = TDEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            self.temp_dir
        )
        
        mock_response = {
            "design": "# 技术方案\n\n## 架构设计\n...",
            "sections": ["架构设计", "接口设计"],
            "summary": "测试总结"
        }
        
        with patch('td_engine_v2.call_llm', return_value=mock_response):
            result = engine.generate_td("测试 PRD", use_llm=True)
            self.assertEqual(result["status"], "completed")
            self.assertIn("design", result)
    
    def test_mock_llm_error(self):
        """测试 Mock LLM 错误"""
        from td_engine_v2 import TDEngine
        
        engine = TDEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            self.temp_dir
        )
        
        with patch('td_engine_v2.call_llm', side_effect=Exception("API Error")):
            result = engine.generate_td("测试 PRD", use_llm=True)
            self.assertEqual(result["status"], "prompt_ready")


class TestResourceManagement(unittest.TestCase):
    """资源管理测试"""
    
    def test_temp_file_cleanup(self):
        """测试临时文件清理"""
        from review_engine import ReviewEngine
        
        engine = ReviewEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            self.temp_dir
        )
        
        # 生成 prompt
        result = engine.review("测试 PRD")
        prompt_file = Path(result["prompt_file"])
        self.assertTrue(prompt_file.exists())
    
    def test_directory_creation(self):
        """测试目录创建"""
        from review_engine import ReviewEngine
        
        output_dir = Path(self.temp_dir) / "new_dir" / "subdir"
        engine = ReviewEngine(
            {"name": "test", "repositories": [], "business_domain": "test"},
            output_dir
        )
        
        result = engine.review("测试 PRD")
        self.assertTrue(output_dir.exists())


def run_tests():
    """运行所有测试"""
    unittest.main(verbosity=2)


if __name__ == "__main__":
    run_tests()
