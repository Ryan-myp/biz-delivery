#!/usr/bin/env python3
"""
完整测试套件 - 最终版

覆盖所有核心引擎和边界情况
"""

import unittest
import sys
import os
import tempfile
import shutil
from pathlib import Path
from typing import Dict, List, Any

# 添加 biz-delivery 路径
sys.path.insert(0, str(Path.home() / "biz-delivery" / "scripts"))


class TestLearnRepo(unittest.TestCase):
    """仓库学习测试"""
    
    def setUp(self):
        self.tmpdir = tempfile.mkdtemp()
        self.repo_path = Path(self.tmpdir) / "test_repo"
        self.repo_path.mkdir()
        
        # 创建测试文件
        (self.repo_path / "main.go").write_text("""
package main

import "fmt"

func main() {
    fmt.Println("Hello")
}
""")
        (self.repo_path / "go.mod").write_text("module test\n\ngo 1.21\n")
    
    def tearDown(self):
        shutil.rmtree(self.tmpdir)
    
    def test_learn_repo(self):
        """测试仓库学习"""
        from learn_repo import LearnRepo
        
        repo = LearnRepo()
        result = repo.learn(self.repo_path)
        
        self.assertEqual(result["status"], "completed")
        self.assertIn("code_structure", result)
        self.assertIn("dependencies", result)


class TestReviewEngine(unittest.TestCase):
    """PRD 审查测试"""
    
    def test_review_prd(self):
        """测试 PRD 审查"""
        from review_engine import ReviewEngine
        
        engine = ReviewEngine()
        prd = {
            "title": "Test Feature",
            "description": "A test feature",
            "requirements": ["req1", "req2"]
        }
        
        result = engine.review(prd)
        
        self.assertEqual(result["status"], "completed")
        self.assertIn("score", result)
        self.assertIn("issues", result)


class TestTDEngineV2(unittest.TestCase):
    """TD 引擎 v2 测试"""
    
    def setUp(self):
        from td_engine_v2 import TDEngine
        self.engine = TDEngine()
    
    def test_generate_td(self):
        """测试 TD 生成"""
        prd = {
            "title": "Test Feature",
            "description": "Test description"
        }
        
        result = self.engine.generate_td(prd)
        
        self.assertEqual(result["status"], "completed")
        self.assertIn("design", result)
        self.assertIsNotNone(result["design"])
    
    def test_generate_td_with_llm(self):
        """测试带 LLM 的 TD 生成"""
        prd = {"title": "Test", "description": "Test"}
        
        # 测试不依赖 LLM 的情况
        result = self.engine.generate_td(prd, use_llm=False)
        
        self.assertEqual(result["status"], "completed")


class TestTestEngine(unittest.TestCase):
    """测试生成引擎测试"""
    
    def setUp(self):
        from test_engine import TestEngine
        self.engine = TestEngine()
    
    def test_generate_tests(self):
        """测试测试生成"""
        code = """
def add(a, b):
    return a + b
"""
        result = self.engine.generate_tests(code, "test_add")
        
        self.assertEqual(result["status"], "completed")
        self.assertIn("tests", result)
        self.assertGreaterEqual(len(result["tests"]), 1)


class TestQueryEvidence(unittest.TestCase):
    """查询证据测试"""
    
    def setUp(self):
        from query_evidence import QueryEngine
        self.engine = QueryEngine()
    
    def test_query(self):
        """测试查询"""
        result = self.engine.query("test query")
        
        self.assertIsNotNone(result)
        self.assertIn("evidence", result)


class TestIntegration(unittest.TestCase):
    """集成测试"""
    
    def test_full_pipeline(self):
        """测试完整流水线"""
        from learn_repo import LearnRepo
        from review_engine import ReviewEngine
        from td_engine_v2 import TDEngine
        from test_engine import TestEngine
        
        # 学习仓库
        repo = LearnRepo()
        learn_result = repo.learn(Path.home() / "biz-delivery" / "scripts")
        
        self.assertEqual(learn_result["status"], "completed")
        
        # 审查 PRD
        review = ReviewEngine()
        prd_result = review.review({
            "title": "Test",
            "description": "Test"
        })
        
        self.assertEqual(prd_result["status"], "completed")
        
        # 生成 TD
        td_engine = TDEngine()
        td_result = td_engine.generate_td(prd_result["prd"])
        
        self.assertEqual(td_result["status"], "completed")
        
        # 生成测试
        test_engine = TestEngine()
        test_result = test_engine.generate_tests(td_result["design"], "test")
        
        self.assertEqual(test_result["status"], "completed")


class TestErrorRecovery(unittest.TestCase):
    """错误恢复测试"""
    
    def test_missing_repo(self):
        """测试仓库不存在"""
        from learn_repo import LearnRepo
        repo = LearnRepo()
        
        result = repo.learn(Path("/nonexistent/path"))
        self.assertEqual(result["status"], "error")
    
    def test_invalid_prd(self):
        """测试无效 PRD"""
        from review_engine import ReviewEngine
        engine = ReviewEngine()
        
        result = engine.review({})
        self.assertEqual(result["status"], "error")
    
    def test_empty_code(self):
        """测试空代码"""
        from test_engine import TestEngine
        engine = TestEngine()
        
        result = engine.generate_tests("", "test")
        self.assertEqual(result["status"], "error")


class TestPerformance(unittest.TestCase):
    """性能测试"""
    
    def test_large_repo(self):
        """测试大仓库学习"""
        from learn_repo import LearnRepo
        import time
        
        repo = LearnRepo()
        start = time.time()
        
        result = repo.learn(Path.home() / "biz-delivery" / "scripts")
        elapsed = time.time() - start
        
        self.assertEqual(result["status"], "completed")
        self.assertLess(elapsed, 30)  # 30秒内完成


class TestEdgeCases(unittest.TestCase):
    """边界情况测试"""
    
    def test_empty_input(self):
        """测试空输入"""
        from review_engine import ReviewEngine
        engine = ReviewEngine()
        
        result = engine.review(None)
        self.assertEqual(result["status"], "error")
    
    def test_very_long_prd(self):
        """测试超长 PRD"""
        from review_engine import ReviewEngine
        engine = ReviewEngine()
        
        long_prd = {
            "title": "A" * 10000,
            "description": "B" * 10000
        }
        
        result = engine.review(long_prd)
        self.assertEqual(result["status"], "completed")
    
    def test_special_characters(self):
        """测试特殊字符"""
        from query_evidence import QueryEngine
        engine = QueryEngine()
        
        result = engine.query("test\n\r\t特殊字符<>{}")
        self.assertIsNotNone(result)


def run_tests():
    """运行所有测试"""
    # 创建测试套件
    loader = unittest.TestLoader()
    suite = unittest.TestSuite()
    
    # 添加测试类
    test_classes = [
        TestLearnRepo,
        TestReviewEngine,
        TestTDEngineV2,
        TestTestEngine,
        TestQueryEvidence,
        TestIntegration,
        TestErrorRecovery,
        TestPerformance,
        TestEdgeCases,
    ]
    
    for test_class in test_classes:
        tests = loader.loadTestsFromTestCase(test_class)
        suite.addTests(tests)
    
    # 运行测试
    runner = unittest.TextTestRunner(verbosity=2)
    result = runner.run(suite)
    
    # 输出摘要
    print("\n" + "=" * 60)
    print("    测试摘要")
    print("=" * 60)
    print(f"总测试数: {result.testsRun}")
    print(f"成功: {result.testsRun - len(result.failures) - len(result.errors)}")
    print(f"失败: {len(result.failures)}")
    print(f"错误: {len(result.errors)}")
    
    if result.failures:
        print("\n失败的测试:")
        for test, traceback in result.failures:
            print(f"  - {test}: {traceback}")
    
    if result.errors:
        print("\n错误的测试:")
        for test, traceback in result.errors:
            print(f"  - {test}: {traceback}")
    
    print("=" * 60)
    
    return result.wasSuccessful()


if __name__ == "__main__":
    success = run_tests()
    sys.exit(0 if success else 1)
