#!/usr/bin/env python3
"""
biz-delivery 集成测试套件

测试完整的业务流程：学习 → 审查 → 设计 → 测试
"""

import sys
import unittest
from pathlib import Path
import json

# 添加 biz-delivery 路径
sys.path.insert(0, str(Path(__file__).parent))


class TestIntegration(unittest.TestCase):
    """集成测试"""
    
    def setUp(self):
        """设置测试环境"""
        from td_engine_v2 import TDEngine
        from review_engine import ReviewEngine
        from test_engine import TestEngine
        from learn_repo import IRDocument
        
        self.profile = {
            "name": "integration-test",
            "repositories": [],
            "business_domain": "test",
        }
        self.output_dir = "/tmp/biz_integration_test"
        Path(self.output_dir).mkdir(parents=True, exist_ok=True)
        
        self.td_engine = TDEngine(self.profile, self.output_dir)
        self.review_engine = ReviewEngine(self.profile, self.output_dir)
        self.test_engine = TestEngine(self.profile, self.output_dir)
        self.ir = IRDocument(repo_name="test", repo_path="/tmp", language="go")
    
    def test_learn_repo_ir(self):
        """测试仓库学习"""
        data = self.ir.to_dict()
        self.assertIn("repo_name", data)
        self.assertIn("language", data)
        self.assertEqual(data["repo_name"], "test")
    
    def test_review_pipeline(self):
        """测试审查流程"""
        prd = """
        # 用户出价系统

        ## 功能需求
        1. 用户设置出价
        2. 支持手动和自动出价
        3. 每日预算控制
        """
        result = self.review_engine.review(prd)
        self.assertEqual(result["status"], "prompt_ready")
        self.assertIn("prompt_file", result)
        
        # 验证 prompt 文件存在
        prompt_file = result["prompt_file"]
        self.assertTrue(Path(prompt_file).exists())
    
    def test_td_pipeline(self):
        """测试 TD 生成流程"""
        prd = """
        # 订单系统

        ## 功能需求
        1. 创建订单
        2. 查询订单
        3. 订单状态流转
        """
        result = self.td_engine.generate_td(prd, use_llm=False)
        self.assertEqual(result["status"], "prompt_ready")
        self.assertIn("prompt_file", result)
    
    def test_test_pipeline(self):
        """测试测试用例生成流程"""
        prd = """
        # 用户登录系统

        ## 功能需求
        1. 用户登录
        2. 用户注册
        3. Token 验证
        """
        result = self.test_engine.generate_tests(prd)
        self.assertEqual(result["status"], "prompt_ready")
    
    def test_full_pipeline(self):
        """测试完整流程"""
        prd = """
        # 广告竞价系统

        ## 功能需求
        1. DSP 竞价
        2. SSP 广告返回
        3. 归因计算
        4. 预算控制
        """
        
        # Step 1: 审查
        review_result = self.review_engine.review(prd)
        self.assertEqual(review_result["status"], "prompt_ready")
        
        # Step 2: TD
        td_result = self.td_engine.generate_td(prd, use_llm=False)
        self.assertEqual(td_result["status"], "prompt_ready")
        
        # Step 3: 测试用例
        test_result = self.test_engine.generate_tests(prd)
        self.assertEqual(test_result["status"], "prompt_ready")
        
        # 验证所有 prompt 文件存在
        self.assertTrue(Path(review_result["prompt_file"]).exists())
        self.assertTrue(Path(td_result["prompt_file"]).exists())
        self.assertTrue(Path(test_result["prompt_file"]).exists())
    
    def test_prompt_content_quality(self):
        """测试 prompt 内容质量"""
        prd = "实现用户出价功能"
        
        review_prompt = self.review_engine._build_prompt(prd)
        td_prompt = self.td_engine._build_prompt(prd)
        test_prompt = self.test_engine._build_prompt(prd)
        
        # 验证 prompt 长度
        self.assertGreater(len(review_prompt), 500)
        self.assertGreater(len(td_prompt), 500)
        self.assertGreater(len(test_prompt), 500)
        
        # 验证 prompt 包含关键词
        self.assertIn("PRD", review_prompt)
        self.assertIn("技术方案", td_prompt)
        self.assertIn("测试用例", test_prompt)


def run_tests():
    """运行所有测试"""
    unittest.main(verbosity=2)


if __name__ == "__main__":
    run_tests()
